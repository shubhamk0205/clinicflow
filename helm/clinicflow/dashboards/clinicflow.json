{
  "title": "ClinicFlow API",
  "uid": "clinicflow-api",
  "schemaVersion": 39,
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries", "title": "Requests per second (by handler)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (handler) (rate(http_requests_total{handler!=\"/metrics\"}[1m]))", "legendFormat": "{{handler}}"}]
    },
    {
      "type": "timeseries", "title": "p95 latency (seconds)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{handler!=\"/metrics\"}[5m])))", "legendFormat": "{{handler}}"}]
    },
    {
      "type": "timeseries", "title": "Error rate (5xx / s)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(http_requests_total{status=\"5xx\"}[1m]))", "legendFormat": "5xx"}]
    },
    {
      "type": "stat", "title": "Backend pods up",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "count(up{job=~\".*backend.*\"} == 1)"}]
    }
  ]
}
