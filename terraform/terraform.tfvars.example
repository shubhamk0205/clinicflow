# Copy to terraform.tfvars and adjust. Never put AWS keys here —
# use `aws configure` or environment variables for credentials.
aws_region          = "ap-southeast-2"
environment         = "dev"
cluster_name        = "clinicflow-eks"
cluster_version     = "1.31"
vpc_cidr            = "10.30.0.0/16"
node_instance_types = ["m7i-flex.large"] # must be free-tier eligible on the AWS Free plan
node_min_size       = 2
node_max_size       = 4
node_desired_size   = 2
